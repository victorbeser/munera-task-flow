# Copie para .env. Nunca publique este arquivo no Git.
NODE_ENV=development
# A aplicação usa este fuso para calcular os horários HH:mm.
TZ=America/Sao_Paulo
# API: localhost por padrão. Não exponha diretamente à Internet.
API_HOST=127.0.0.1
API_PORT=47831
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=COLOQUE_AQUI_UM_TOKEN_ALEATORIO_DE_64_CARACTERES
# Origens do painel autorizadas a usar a API pelo navegador (separadas por vírgula).
# Deixe vazio se o painel usar um backend intermediário.
CORS_ORIGINS=
# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=muneradb
PGUSER=munera_app
PGPASSWORD=ALTERE_ESTA_SENHA
PGSSLMODE=disable
PGPOOL_MAX=10
# Diretórios; relativos à raiz do projeto Munera.
LOG_DIR=./src/log
# Raízes permitidas para scripts; separadas por ; (evita conflito com C:\ no Windows).
SCRIPT_ROOTS=./scripts
# Frequência do agendador e limites
SCHEDULER_POLL_MS=1000
DEFAULT_TIMEOUT_SECONDS=3600
MAX_CONCURRENT=4
LOG_MAX_BYTES=104857600
# Binários disponíveis no PATH ou caminhos absolutos
NODE_BIN=node
PHP_BIN=php
BASH_BIN=bash
POWERSHELL_BIN=pwsh
CMD_BIN=cmd.exe
# Windows PowerShell 5.1: POWERSHELL_BIN=powershell.exe
# No Linux, .bat não é suportado; .sh precisa de bash instalado.
